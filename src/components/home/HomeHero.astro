---
import { STORE_INFO } from '@domain/shared/store.constants';
---

<section class="mx-auto max-w-[1280px] px-5 sm:px-8 pt-6 pb-8">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
    <!-- Banner promocional principal (izquierda, estilo 19.76 Store) -->
    <a
      href="/catalogo?categoria=audifonos"
      class="group relative lg:col-span-9 min-h-[300px] sm:min-h-[360px] rounded-xl overflow-hidden bg-gradient-to-r from-[#b90024] via-[#d9044d] to-[#c40028] flex items-center"
    >
      <img
        src="/images/hero-earbuds.jpg"
        alt="Audífonos inalámbricos en promoción"
        class="absolute inset-0 h-full w-full object-cover object-right transition-transform duration-700 group-hover:scale-[1.03]"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-[#9e001f]/90 via-[#b90035]/55 to-transparent sm:via-[#b90035]/35"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 max-w-md px-7 sm:px-12 py-10 text-white">
        <div class="flex items-center gap-6 text-[11px] font-semibold uppercase tracking-widest text-white/85">
          <span>Oferta de la semana</span>
          <span>Stock limitado</span>
        </div>

        <h1 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight leading-tight">
          Audífonos &amp; Pack Funda + Mica
        </h1>

        <p class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight">
          Desde S/ 20
        </p>

        <p class="mt-5 text-[11px] leading-relaxed text-white/80 max-w-xs">
          Atención personalizada en {STORE_INFO.address} y pedidos rápidos por WhatsApp
          ({STORE_INFO.whatsappDisplay}). Fundas para Samsung, Motorola, Xiaomi y iPhone.
        </p>

        <span class="mt-6 inline-flex items-center gap-2 rounded-lg bg-white/15 backdrop-blur-sm border border-white/25 px-4 py-2 text-xs font-semibold text-white group-hover:bg-white group-hover:text-zinc-900 transition-colors">
          Ver catálogo completo
          <span aria-hidden="true">&rarr;</span>
        </span>
      </div>
    </a>

    <!-- Tarjeta vertical derecha destacada (Fundas) -->
    <a
      href="/catalogo?categoria=fundas"
      class="group relative lg:col-span-3 min-h-[280px] sm:min-h-[360px] rounded-xl overflow-hidden bg-[#f5f5f7] flex flex-col justify-between p-6 transition-shadow hover:shadow-md"
    >
      <div class="relative z-10">
        <h2 class="text-2xl font-semibold tracking-tight text-zinc-900">
          Fundas
        </h2>
        <p class="mt-1 text-xs font-medium text-zinc-500">
          Desde S/ 35 · + Mica S/ 10
        </p>
      </div>

      <div class="relative mt-4 flex-1 flex items-end justify-center">
        <img
          src="/images/funda-color.jpg"
          alt="Fundas para celular desde S/ 35"
          class="w-full max-w-[230px] aspect-square object-contain mix-blend-multiply transition-transform duration-500 group-hover:scale-105"
        />
      </div>
    </a>
  </div>
</section>
